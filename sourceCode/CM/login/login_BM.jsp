ssWD.value = frm.passWD.value.trim();					frm.action = "<%=dispatcher%>/login/input?newTxRequest=true";				}			}			function messageHandler(){				var msgs = new Array(<%=msg.getLength()%>);				<%				int msglen = msg.getLength();				int msgidx = 0;				String[][] showmsg = new String[msglen][7];				com.cathay.common.bo.ReturnMessage tmp=null;				while(msg.hasNext()){					tmp=msg.next();					String displayMsgDescs = tmp.getDisplayMsgDescs();					if(displayMsgDescs!=null){						displayMsgDescs = displayMsgDescs.replaceAll("\\r\\n", "<br>").replaceAll("\\n", "<br>").replaceAll("\\r", "<br>");					}else{						displayMsgDescs = "";					}					String msgid = tmp.getMsgid();					if(msgid!=null){						msgid = msgid.replaceAll("\\r\\n", "<br>").replaceAll("\\n", "<br>").replaceAll("\\r", "<br>");					}else{						msgid = "";					}					String displayException = tmp.getDisplayException();					if(displayException!=null){						displayException = displayException.replaceAll("\\r\\n", "<br>").replaceAll("\\n", "<br>").replaceAll("\\r", "<br>");					}else{						displayException = "";					}					showmsg[msgidx][0] = displayMsgDescs;					showmsg[msgidx][1] = msgid;					showmsg[msgidx][2] = (tmp.getSysid()!=null)?tmp.getSysid():"";					showmsg[msgidx][3] = (tmp.getType()!=null)?tmp.getType():"";					showmsg[msgidx][4] = (tmp.getUrl()!=null)?tmp.getUrl():"";					showmsg[msgidx][5] = tmp.getReturnCode()+"";					showmsg[msgidx][6] = displayException;				%>					msgs[<%=msgidx%>] = new Array(						"<%=showmsg[msgidx][0]%>".replace(/<br>/gi, "\n")						,"<%=showmsg[msgidx][1]%>".replace(/<br>/gi, "\n"),"<%=showmsg[msgidx][2]%>"						,"<%=showmsg[msgidx][3]%>","<%=showmsg[msgidx][4]%>","<%=showmsg[msgidx][5]%>","<%=showmsg[msgidx][6]%>");				<%					msgidx++;				}				%>				//¿ù»~®É¤~»Ý­nAlert				function alertMessages(){					var displayMessage = "";					for( var varindex=0;varindex<msgs.length;varindex++){						if (msgs[varindex][6] == ""){							if (msgs[varindex][5] != "0"){//new								displayMessage+=msgs[varindex][0]+"\n\n";	//new							}						}else{							if ((msgs[varindex][6] != "") || (msgs[varindex][2] != "")){								displayMessage+="²§±`­ì¦]:"+msgs[varindex][6]+"\n";								displayMessage+="\nµ{¦¡ID:"+msgs[varindex][2]+"\n\n";							}						}					}					if (displayMessage != ""){						alert(displayMessage);					}				}				alertMessages();				document.form1.userID.focus();			}			function initApp(){				messageHandler();				var linkURL = "${htmlBase}/CM/login/messageBox_BM.jsp";				var windowName = "¤½§i°T®§";				var attribute = "status=no,toolbar=no,resizable=no,scrollbars=no,width=500,height=325,top=200,left=200";				window.open(linkURL,windowName,attribute);			}		</script>	</head>	<body leftmargin="0" topmargin="0" onload="initApp();">		<div align="left">			<table width="98%" border="0" cellpadding="0" cellspacing="0">				<tr>				  <td width="262"><img src="<%=imageBase%>/BG/login_01.jpg" width="262" height="164" alt=""></td>				  <td width="301"><img src="<%=imageBase%>/BG/login_02.jpg" width="301" height="164" alt=""></td>				  <td background="<%=imageBase%>/BG/login_03.jpg">&nbsp;</td>				  <td width="233"><img src="<%=imageBase%>/BG/login_04.jpg" width="233" height="164" alt=""></td>				</tr>			</table>			<table width="98%" border="0" cellspacing="0" cellpadding="0">				<tr>					<td width="29"><img src="<%=imageBase%>/BG/login_05.jpg" width="29" height="315" alt=""></td>					<td bgcolor="#FFFFFF">						<TABLE width="45%" border=0 align=center cellPadding=3 cellSpacing=1 bgcolor="#E7DA7E">							<form method="POST" name="form1" action="" >							<input type="hidden" name="function_id" value="" />							<input type="hidden" name="url" value="" />							<input type="hidden" name="loginPlatform" value="BM" />								<tr valign="middle" bgcolor="E8D7A1" class="a3" height="23">									<td height="23" colspan="2"><p align="center"><strong><span lang="EN-US">¨­¤ÀÅçÃÒ</span></strong></p></td>								</tr>								<tr bgcolor="#FFFFFF" height="24">									<td height="24" valign="middle" class="a4"><p align="center"><span lang="EN-US" >±b¸¹</span></p></td>									<td width="295" height="24" valign="middle" class="a4"><span lang="EN-US"><input type="text" name="userID" size="20" /></span></td>								</tr>								<tr bgcolor="#FFFFFF" height="24">									<td height="24" valign="middle" class="a4"><p align="center"><span lang="EN-US" >±K½X</span></p></td>									<td width="295" height="24" valign="middle" class="a4">										<span lang="EN-US"><input type="password" name="passWD" size="20" /></span>										<span class="text10">¡]ª`·N­^¤å¤j¤p¼g¡^</span>										<input name="security" type="hidden" value="0">										<input name="hostName" type="hidden" value="<%=request.getServerName()%>">									</td>								</tr>								<tr bgcolor="#FFFFFF" height="24">									<td height="24" colspan="2" valign="middle" class="a4"><p align="center"><span lang="EN-US"><input type="submit"  name="submit" value="°e¥X" onclick="check();"></span></p></td>								</tr>					                <tr bgcolor="#FFFFFF" height="24">									<td colspan="2" colspan="2" valign="middle"><a href="<%=BM_location%>/BMM0_9999/prompt" >¾Ç®Õ¦Ñ®vµù¥U</a></td>				                </tr>											  </form>						</TABLE>					</td>				</tr>			</table>			<table width="98%" border="0" cellspacing="0" cellpadding="0">				<tr>					<td width="222"><img src="<%=imageBase%>/BG/login_07.jpg" width="222" height="47" alt=""></td>					<td background="<%=imageBase%>/BG/login_11.jpg"><div align="center"><img src="<%=imageBase%>/BG/login_08.jpg" width="432" height="47"></div></td>				</tr>			</table>		</div>	</body></html>