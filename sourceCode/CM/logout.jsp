<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN"><%@ page language="java" contentType="text/html; charset=BIG5" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib uri="/CXL" prefix="CXL" %><%@ page import="com.cathay.common.util.LoginUtil" %><CXL:csCommon trace="false" htmlBaseName="htmlBase" cssBaseName="cssBase" imageBaseName="imageBase" dispatcherName="dispatcher" /><HTML><HEAD><meta http-equiv="Content-Type" content="text/html; charset=BIG5"><META name="GENERATOR" content="IBM WebSphere Studio"><title>國泰人壽</title><link href="<%=cssBase%>/cm.css" rel="stylesheet" type="text/css"><%	boolean isamLogOut = "Y".equals(pageContext.getAttribute("isamLogOut"));	pageContext.setAttribute("isamLogOut", isamLogOut);	if(isamLogOut){		pageContext.setAttribute("isProd", LoginUtil.isProd());		pageContext.setAttribute("isStag", LoginUtil.isStag());	}%>  <c:choose><c:when test="${isamLogOut}">	<script type="text/javascript">	function loadFunc(){		document.getElementById('logoutFrame').onload = function(){			window.close();		};				var logOutUrl = '${logOutUrl}';		// 防止properties未定義		if(!logOutUrl){			var prefix;			if(${isProd}){				prefix = '';			}else if(${isStag}){				prefix = 's';			}else{				prefix = 't';			}			logOutUrl = 'https://' + prefix + 'w3.cathaylife.com.tw/pkmslogout';		}				var logoutForm = document.getElementById('logoutForm');		logoutForm.action = logOutUrl;		logoutForm.submit();	}	</script>		</head>	<body bgcolor="#B9C884" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0" onload="loadFunc()">		<form id="logoutForm" name="logoutForm" method="post" target="logoutFrame">			<iframe id="logoutFrame" name="logoutFrame" width="0" height="0"></iframe>		</form>	</body>	</html></c:when><c:otherwise>	<script language="JavaScript" type="text/JavaScript">	function winclose() { //v3.0		window.close();	}	</script>	</head>	<body bgcolor="#B9C884" leftmargin="0" topmargin="0" marginwidth="0" marginheight="0" onload="winclose()">	</body>	</html></c:otherwise></c:choose>