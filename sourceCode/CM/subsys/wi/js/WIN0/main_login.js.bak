    var seekUrl = function(){
        var path = $(location).attr('pathname');
        var replace = "/web/m/";
        var check = function(a_lv, a_pathAry, a_mapAry, a_return){
            var total = a_pathAry.length;
            var i;
            if(a_return == undefined){
                a_return = [];
            }
            for(i=a_lv;i<total;i++){
                for(var ii in a_mapAry){
                    if(a_mapAry[ii].url == a_pathAry[i] && a_pathAry[i] != ""){
                        a_return.push({label:a_mapAry[ii].label,url:a_mapAry[ii].url,laptop:a_mapAry[ii].laptop});
                        if(a_mapAry[ii].section != undefined){
                            return check(i+1,a_pathAry,a_mapAry[ii].section,a_return);
                        }else{
                        }
                    }
                }
            }
            return a_return;
        }
        path = path.substr(path.indexOf(replace)+replace.length,path.length);        
        var extIndex = path.lastIndexOf(".");
        if(extIndex>-1){
            path = path.substr(0,extIndex);
        }
        path = path.split("/");
        return check(0, path, urlMappingAry);
    }

    var setUserViewMode = function(a_mode){
        var link = JS_PATH+"/vendor/jquery.cookie.js"
        yepnope({
            //load:"/web/m/js/vendor/jquery.cookie.js"
            test:$.cookie
            ,nope:link
            ,complete:function(){
                //$.removeCookie(USER_MODE_SAVE_COOKIE_NAME, { path: '/' }); 
                //set cookie
                if(location.hostname.indexOf('cathayholdings')>-1){
                    $.cookie(USER_MODE_SAVE_COOKIE_NAME, a_mode, {path: '/life/web/', expires: USER_MODE_SAVE_DAYS});
                }else{
                    $.cookie(USER_MODE_SAVE_COOKIE_NAME, a_mode, {expires: USER_MODE_SAVE_DAYS});
                }
            }
        });
    }

    /** TODO
     * call: getUserViewMode(initMobileSite);
     * callback: a_cb => initMobileSite()
     *      initMobileSite($.cookie(USER_MODE_SAVE_COOKIE_NAME)){...}
     */
    var getUserViewMode = function(a_cb){
        var link = JS_PATH+"/vendor/jquery.cookie.js"
        yepnope({
            //load:"/web/m/js/vendor/jquery.cookie.js"
            test:$.cookie
            ,nope:link
            ,complete:function(){                
                //setUserViewMode(USER_MODE_MOBILE);
                if(a_cb!=undefined){
                    a_cb($.cookie(USER_MODE_SAVE_COOKIE_NAME));
                }
            }
        });
    }

    var url = function(a_str,a_window){
        var link = "";
        switch(a_str){
            case "desktop_home"://url("desktop_home");
                //set cookie
                setUserViewMode(USER_MODE_LAPTOP);
                link = DOMAIN_HODLDINGS + '/web/';
            break;
            case "member_zone"://url("member_zone");
                link =  DOMAIN_LIFE + "/wps/portal/B2C/Member";
            break;
            case "logout"://url("logout");
                link = location.protocol+'//'+location.hostname.replace("www.cathayholdings.com", "www.cathaylife.com.tw")+'/pkmslogout?filename=logout_success.html';
            break;
            case "desktop_member_login"://url("desktop_member_login");
                link = DOMAIN_LIFE +"/wps/portal/B2C/Member";
            break;
            case "service_center_location"://url("service_center_location");
                link = DOMAIN_HODLDINGS +"/web/ext/pages/service/contactus/ser_address.html";
            break;
            case "downloadAPPiOS"://url('downloadAPPiOS');
                link = 'http://itunes.apple.com/tw/app/id432046643';                
            break;
            case "downloadAPPAndroid"://url('downloadAPPAndroid');
                link = 'https://play.google.com/store/apps/details?id=com.cathay.main';                
            break;
            case "downloadAPP"://url('downloadAPP');                
                //link = DOMAIN_LIFE + '/wps/B2CWeb/html/mmldownload.jsp';//https://www.cathaylife.com.tw/bc/wps/B2CWeb/html/mmldownload.jsp
                link = DOMAIN_LIFE + '/B2CWebGroup/MyMobiLife/download.jsp';//https://www.cathaylife.com.tw/bc/B2CWebGroup/MyMobiLife/download.jsp
            break;
            
            case "member_registration"://url("member_registration","cathaylifeMember");
            	link =  DOMAIN_LIFE + "/wps/portal/B2C/Member/Registration";
        	break;
        }
        if(a_window){
            window.open(link,a_window);
        }else{
            location.href=link;
        }        
    }

    var toggleMemberStatus = function(a_str){
        switch(a_str){
            case "guest":
                //toggle guest
                $("#member_btn").show();
                $("#member_logout_btn").hide();

                $("#footer_guest").show();
                $("#footer_member").hide();
            break;

            case "member":
                //toggle member
                $("#member_btn").hide();
                $("#member_logout_btn").show();
                //$("#member_content").remove();//header 登入區塊
                $("#member_content").hide();//header 登入區塊
                
                $("#footer_guest").hide();
                $("#footer_member").show();
            break;
        }
    }

    /**
     * load cross domain js
     **/
    var loadCrossScript = function(scriptUrl) {
        var script = document.createElement('script');
        script.type = 'text/javascript';
        script.src = scriptUrl;
        document.getElementsByTagName('head')[0].appendChild(script);
    }

    /**
     * load cross domain image
     **/
    var loadCrossImg = function(imgUrl) {
        var img = document.createElement('img');
        img.src = imgUrl;
        document.getElementsByTagName('body')[0].appendChild(img);
    }

