            url("desktop_home");
        });
        
        $(".btn_login").bind("click",function(){
            url("member_zone","cathaylifeMember");
        });
        
        $(".btn_logout").bind("click",function(){
            doLogout();
        });
        
        $(".btn_registration").bind("click",function(){
    				url("member_registration","cathaylifeMember");
            //TODO
            //location.href="/bc/WIWeb/servlet/HttpDispatcher/WIN0_1010/prompt";
            //location.href="/bc/WIWeb/html/WI/N0/WIN0_1000/WIN01010.jsp";
				});

        $(".btn_forget_pw").bind("click",function(){
						var action = 'https://'+main_login.getEnvironment()+'www.cathaylife.com.tw/oc/OCWeb/servlet/HttpDispatcher/OCTxBean/execute?ACTION_NAME=OCZ1_0200&METHOD_NAME=initData';
            var forgetFrm = $('<form id="forgetpw" method="post" target="cathaylifeMember" action="'+action+'"><input type="hidden" name="type" value="forgetPwd"></form>');
            forgetFrm.submit();
        });

        $(".btn_use_mobile").bind("click",function(){
            setUserViewMode(USER_MODE_MOBILE);
        });

        //TODO set all site behavior to stay user on mobile site
