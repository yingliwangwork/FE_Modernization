    //search
    var initSearch = function(){
        $(".btn_footer_search").on('click', function(){
            $(".form_row",$("#searchFrm")).removeClass("error");
            var query=document.getElementById("query").value; 
            if(query==null || query==""){
                $(".form_row",$("#searchFrm")).addClass("error");
                $(".error_hint",$("#searchFrm")).html("請勿以空白查詢!");
                return false; 
            }else{
                /*var pattern = /(^[\u4e00-\u9fa5a-zA-Z0-9])/;*/ 
                var pattern = /(^[\u4E00-\u9FA5A-Za-z0-9]+$)/; 
                if (!pattern.test(query)){
                    $(".form_row",$("#searchFrm")).addClass("error");
                    $(".error_hint",$("#searchFrm")).html("請勿輸入特殊字元!");
                    return false; }
                else{                    
                    document.searchFrm.submit(); 
                }
            } 
        });
    }//search end

