    var loginComplete = function(){
        //add new nav to flexnav
        var member_zone_url = "https://"+location.protocol+"//"+ location.hostname.replace("www.cathayholdings.com", "www.cathaylife.com.tw") +"/bc/wps/portal/B2C/Member";

        var memberNavHTML = "";
        memberNavHTML += '<li>';

        //memberNavHTML += '<a href="https://www.cathaylife.com.tw/bc/wps/portal/B2C/Member" class="block p_15 clearfix">';
        memberNavHTML += '<a href="';
        memberNavHTML += member_zone_url;
        //memberNavHTML += '" class="block p_15 clearfix">';
        memberNavHTML += '" class="block p_15 clearfix" target="cathaylifeMember">';

        memberNavHTML += '<p class="float_l black_dark_text">會員專區</p>';
        memberNavHTML += '<i class="float_r green icon_arrow_right"></i>';
        memberNavHTML += '</a>';
        memberNavHTML += '</li>';
        $(memberNavHTML).insertAfter($(".menu_main .flexnav li:eq(0)"));
        toggleMemberStatus("member");
    }

