        });
    }

    var initFancybox = function(){
        // lightbox
        if($(".fancybox").length==0)
            return;

        yepnope({
            test:$.fancybox
            ,nope:JS_PATH+"/vendor/jquery.fancybox.pack.js"
            ,callback: function (url, result, key) {
            }
            ,complete:function(){
                $(".fancybox").fancybox({
                    padding: 0,
                    width       : '100%',
                    height      : 'auto',
                    autoSize    : false,
                    scrolling: 'no',
                    fitToView: false,
                });
                        
                $(".btn_fancybox_close, .btn_lb_close").click(function(){
                    $.fancybox.close(); 
                    return false;
                });
            }
        });        
    }

    var initFormElement = function(){
        //$('#productFilter li input').uniform
        yepnope({
            test:$.uniform
            ,nope:JS_PATH+"/vendor/jquery.uniform.min.js"
            ,complete:function(){
                $("select, input, textarea").uniform();
                $("input[type='date'], input[type='time']").bind("click",function(){
                    $(this).removeClass('placeholderclass');
                });
                // input text yellow hint
                $(".has_hint").focus(function(){
                    $(this).parent("label").parent("div").addClass("hint");
                });
                $(".has_hint").focusout(function(){
                    $(this).parent("label").parent("div").removeClass("hint");
                });
            }
        });
    }

    var initFlexSlide = function(){
        if($('.flexslider').length==0)
            return;
        yepnope({
            test:$.flexslider
            ,nope:JS_PATH+"/vendor/jquery.flexslider.js"
            ,complete:function(){
                $('.flexslider').flexslider({
                    controlNav: true,
                    directionNav: false,
                    slideshowSpeed: 7000,
                    animationSpeed: 600,
                    animation: "slide",
                });
            }
        });
    }

    var initCollapse = function(){
        var o = $('.collapse_title');
        if( !o[0] ) return;
        
        $('.collapse_content').hide();
        
        $('.collapse_title').on('click', function(){
            $(this).parent().find('.icon_collapse').toggleClass("close");
            var t = this;
            $(this).next('.collapse_content').slideToggle(150);
        });
        if( $('html.ie8')[0] )
            $('.collapse_title').css('overflow','visible').children('b').css('height','auto');
        
        $('.collapse_title_inside').on('click', function(){
            $(this).parent().prev('.collapse_title').trigger('click');
        });
    }

    var redirectToLaptop = function(){
        //do redirector
        var obj = seekUrl();
        if(obj.length==0){
            url = DOMAIN_HODLDINGS+"/web/index.html";
        }else{
            var url = DOMAIN_HODLDINGS+obj[obj.length-1].laptop;
        }
        //TODO
        //window.open(url);//為了方便測試，先開 window.open 但 browser 會擋
        location.href = url;//正式上線要開這個 #Production
    }

    //TODO
    var downloadApp = function(){
        if(isMobile.iOS()){//Apple
            url('downloadAPPiOS');
        }else if(isMobile.Android()){//Android            
            url('downloadAPPAndroid');
        }else{//default
            url('downloadAPP');
        }
    }

    var initMobileSite = function(a_userMode){
        //TODO 方便測試使用，如果是laptop模式，每次進來就會一起開啟桌機相對網址，
        /*if(a_userMode == USER_MODE_LAPTOP){
            redirectToLaptop();
        }*/
        
        switch(a_userMode){
            //TODO 方便測式先關掉
            /*case USER_MODE_LAPTOP://laptop
                //redirectToLaptop();//#Production
                //setUserViewMode(USER_MODE_UNDEFINED);//undefined
            break;*/
            
            default://mobile|undefined
                setUserViewMode(USER_MODE_UNDEFINED);//undefined
                initloginStatus();//
                initHeaderNav();
                initFooterNav();
                initFormElement();
                initFancybox();
                initFlexSlide();
                initCollapse();
                initSearch();
                updateBreadcrumb();
                seekFocusNav();
            break;
        }
    }
    return {
        //main function to initiate the module
        init: function () {
            getUserViewMode(initMobileSite);
        },
        use: function(a_str){
            switch(a_str){
                case "collapse":
                    initCollapse();
                break;
                case "fancybox":
                    initFancybox();
                break;
                case "flexSlider":
                    initFlexSlide();
                break;
            }
        },
        doLogout: function(){
            //url("logout");
            doLogout();
        },
        doLogin: function(target){
            if(target){
                url("member_zone",target);//target='cathaylifeMember'
            }else{
                login();
            }            
        },
        toggleMemberStatus: function(type){
            if(type==='member'){
                loginComplete();
            }else{
                toggleMemberStatus(type);//'guest'
            }  
        }
    };
}();

/**
 *  must be this function name 'doStscbb'
 *  because of extant JSP API
 **/
var doStscbb = function (type, name) {
    CathayMobile.toggleMemberStatus(type);
}

