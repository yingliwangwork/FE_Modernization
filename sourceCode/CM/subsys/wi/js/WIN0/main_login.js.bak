    var initHeaderNav = function(){
        //Menu
        //超過 {limit} 個 就隱藏並且加上看全部
        var limit = 7;
        if($(".flexnav").length>0){
            yepnope({
                test:$.flexNav
                ,nope:JS_PATH+"/vendor/jquery.flexnav.min.js"
                ,complete:function(){
                    $(".flexnav").flexNav();
                    $(".item-with-ul").each(function(){
                        var ulElm = $(">ul",$(this));
                        if(ulElm.length>0){
                            //have submenu
                            if($(">li",ulElm).length>limit){
                                var liElm = $(">li:gt("+(limit-1)+")",ulElm);
                                $(liElm).addClass("menu_main_item more").hide();
                                //
                                var allHtml = '';
                                allHtml += '<li class="menu_main_item more more_toggle">';
                                allHtml += '<a href="javascript:;" class="block p_15 pl_30 clearfix">';
                                allHtml += '<p class="gray_deep_text"><i class="icon_collapse open gray mr_5"></i>看全部</p>';
                                allHtml += '</a>';
                                allHtml += '</li>';
                                $(ulElm).append(allHtml);
                                //
                                $(".menu_main_item.more_toggle").on("click",function(e){
                                   e.preventDefault();
                                   $(this).siblings().show();
                                   $(this).remove();
                                   return false;
                                });
                            }
                        }
                    })
                    $(".item-with-ul>a").on("click",function(e){
                       e.preventDefault();
                       $(this).parent().find("ul").toggle();
                       $(this).parents(".item-with-ul").siblings().find("ul").hide();
                       return false;
                    });
                }
            });
        }
        $(".menu-button").on("click",function(){
            $('#member_content').hide();
            $('#location_content').hide();
            //
            $("#menu_main>a").toggleClass("active");
            $("#location_btn").removeClass("active");
            $("#member_btn").removeClass("active");
        });
        //Member
        initHeaderNavMember();
        //Location
        initHeaderNavLocation();
    }

    var seekFocusNav = function(){
        //設定active
        var currentPath = $(location).attr('pathname');
        $("a[href='"+currentPath+"']").addClass("active");
    }

    //更新麵包屑
    var updateBreadcrumb = function(){
        //跟seekUrl 要資料
        var obj = seekUrl();
        var html = '<a href="/web/m/" class="green_light btn_link">首頁</a>';
        var url ='/web/m/';

        var total = obj.length;
        var i;
        //產生麵包屑HTML
        for(i=0;i<total;i++){
            html += '&gt; '
            if(i==total-1){
                html += obj[i].label;
            }else{
                url += obj[i].url +'/';
                html += '<a href="'+url+'" class="green_light btn_link">'+obj[i].label+'</a>';
            }
        }
        $(".breadcrumb").html(html);
    }

    var initFooterNav = function(){
        //超過 {limit} 個 就隱藏並且加上看全部
        var limit = 7;
        //main menu
        $(".footer_menu_main>li").each(function(){
            if($("ul",$(this)).length>0){
                $(">a",$(this)).addClass("footer_submenu");
            }
        })
        
        $(".footer_menu_main").each(function(){
            var ulElm = $(this);
            //have submenu
            if($(">li",ulElm).length>limit){
                var liElm = $(">li:gt("+(limit-1)+")",ulElm);
                $(liElm).addClass("more").hide();
                //
                var allHtml = '';
                allHtml += '<li class="bd_b_1 bd_white more_toggle">';
                allHtml += '<a href="javascript:void(0);" class="block p_15 bg_green_light clearfix">';
                allHtml += '<p class="white"><i class="icon_collapse open white mr_5"></i>看全部</p>';
                allHtml += '</a>';
                allHtml += '</li>';
                $(ulElm).append(allHtml);
                $(".footer_menu_main .more_toggle").on("click",function(e){
                   e.preventDefault();
                   $(this).siblings().show();
                   $(this).remove();
                   return false;
                });
            }
        })
        //footer_submenu_more
        $(".footer_submenu_more").hide();
        $(".footer_submenu_more").each(function(){
            var ulElm = $(this);
            //have submenu
            if($(">li",ulElm).length>limit){
                var liElm = $(">li:gt("+(limit-1)+")",ulElm);
                $(liElm).addClass("more").hide();
                //
                var allHtml = '';
                allHtml += '<li>';
                allHtml += '<a href="javascript:;" class="block p_15 pl_30 bg_gray_lightest clearfix more_toggle">';
                allHtml += '<p class="gray_deep_text"><i class="icon_collapse open gray mr_5"></i>看全部</p>';
                allHtml += '</a>';
                allHtml += '</li>';
                $(ulElm).append(allHtml);
                //
                $(".footer_submenu_more .more_toggle").on("click",function(e){
                   e.preventDefault();
                   $(this).parent().siblings().show();
                   $(this).parent().remove();
                   return false;
                });
            }
        })

        $(".footer_submenu").click(function(){
            $(this).next(".footer_submenu_more").toggle();
           $(this).parents("li").siblings().find("ul").hide();
        });

        //
